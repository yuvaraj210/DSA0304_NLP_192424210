      "source": [
        "import nltk\n",
        "from nltk.tag import UnigramTagger\n",
        "from nltk.corpus import brown\n",
        "\n",
        "nltk.download('brown')\n",
        "\n",
        "data = brown.tagged_sents()[:500]\n",
        "\n",
        "tagger = UnigramTagger(data)\n",
        "\n",
        "sentence = input(\"Enter sentence: \").split()\n",
        "\n",
        "print(tagger.tag(sentence))"
      ]
    }
  ]
