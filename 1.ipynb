        "import re\n",
        "\n",
        "text = input(\"Enter text: \")\n",
        "pattern = input(\"Enter pattern: \")\n",
        "\n",
        "result = re.search(pattern, text)\n",
        "\n",
        "if result:\n",
        "    print(\"Pattern found:\", result.group())\n",
        "else:\n",
        "    print(\"Pattern not found\")"
      ],
