          "text": [
            "Enter words: playing worked quickly book\n",
            "[('playing', 'VBG'), ('worked', 'VBD'), ('quickly', 'RB'), ('book', 'NN')]\n"
          ]
        }
      ],
      "source": [
        "from nltk import RegexpTagger\n",
        "\n",
        "patterns = [\n",
        "    (r'.*ing$', 'VBG'),\n",
        "    (r'.*ed$', 'VBD'),\n",
        "    (r'.*ly$', 'RB'),\n",
        "    (r'.*', 'NN')\n",
        "]\n",
        "\n",
        "tagger = RegexpTagger(patterns)\n",
        "\n",
        "words = input(\"Enter words: \").split()\n",
        "\n",
        "print(tagger.tag(words))"
      ]
    }
  ]
}