            "Enter words: playing running studies connected\n",
            "playing -> play\n",
            "running -> run\n",
            "studies -> studi\n",
            "connected -> connect\n"
          ]
        }
      ],
      "source": [
        "from nltk.stem import PorterStemmer\n",
        "\n",
        "ps = PorterStemmer()\n",
        "\n",
        "words = input(\"Enter words: \").split()\n",
        "\n",
        "for word in words:\n",
        "    print(word, \"->\", ps.stem(word))"
      ]
