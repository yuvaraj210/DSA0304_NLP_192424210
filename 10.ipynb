          "text": [
            "Enter words: The boy playing cricket\n",
            "[('The', 'NN'), ('boy', 'NN'), ('playing', 'VBG'), ('cricket', 'NN')]\n"
          ]
        }
      ],
      "source": [
        "words = input(\"Enter words: \").split()\n",
        "\n",
        "tags = [\"NN\"] * len(words)\n",
        "\n",
        "for i in range(len(words)):\n",
        "    if words[i].endswith(\"ing\"):\n",
        "        tags[i] = \"VBG\"\n",
        "\n",
        "print(list(zip(words, tags)))"
      ]
    }
  ]
